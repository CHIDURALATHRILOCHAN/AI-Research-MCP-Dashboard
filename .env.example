PORT=3000
DEMO_MODE=true
DIGEST_CRON=0 8 * * 1
SCHEDULE_TIMEZONE=Asia/Kolkata

# GitHub
GITHUB_TOKEN=
GITHUB_QUERY=topic:artificial-intelligence stars:>100 pushed:>2026-01-01

# Reddit (a public JSON endpoint is used when credentials are absent)
REDDIT_SUBREDDITS=MachineLearning,LocalLLaMA,artificial

# Google News RSS works without credentials
GOOGLE_NEWS_QUERY=artificial intelligence OR AI model release

# YouTube Data API v3 (optional)
YOUTUBE_API_KEY=
YOUTUBE_QUERY=artificial intelligence research OR AI model release

# Google Calendar: supply a Google Calendar API access token and calendar ID
GOOGLE_CALENDAR_TOKEN=
GOOGLE_CALENDAR_ID=primary

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Research Intelligence <research@example.com>
DIGEST_RECIPIENTS=
